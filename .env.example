# Public frontend env — safe to expose in the browser (RLS protects the data).
# Set the REAL values in Vercel: Project Settings → Environment Variables.
# (Vercel already has VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY configured.)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Never commit the service_role key anywhere. If admin API access is ever needed,
# set SUPABASE_SERVICE_ROLE_KEY only in the provider's env UI (server-side), never in files.
