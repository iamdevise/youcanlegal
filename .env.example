# ---------------------------------------------------------------------------
# Public frontend env — safe to expose in the browser (RLS protects the data).
# Set the REAL values in Vercel: Project Settings → Environment Variables.
# (Vercel already has VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY configured.)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---------------------------------------------------------------------------
# Server-side env for the /api/apply function ONLY.
# These are read inside api/apply.js and are never exposed to the browser.
# Add them in Vercel: Project Settings → Environment Variables (all
# environments), then redeploy. Never commit real values.
# ---------------------------------------------------------------------------
# Resend API key used to email new applications.
RESEND_API_KEY=
# Optional sender address (default onboarding@resend.dev). Must be an
# address on a domain verified in Resend if you change it.
RESEND_FROM=onboarding@resend.dev

# Optional fallback recipient. The live value normally comes from the
# `notification_email` row of the `site_settings` table (Admin → Settings).
NOTIFY_EMAIL=

# The function reuses the existing Supabase settings by default, but you may
# set explicit server-side names instead of the VITE_ ones above:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Never commit the service_role key anywhere. This project does not use it in
# any form — the admin area runs on Supabase Auth + RLS, and the public form
# inserts through the anon key.
